PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
# Railway Postgres keeps accounts and messages across restarts and deploys.
DATABASE_URL=
# Railway volume keeps uploaded files across deploys. Railway sets this when a volume is mounted.
RAILWAY_VOLUME_MOUNT_PATH=
# Calendar wipe uses this timezone. Default is Eastern time.
WIPE_TIMEZONE=America/New_York
